              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Dictionary reflects updated sensor\", () => {",
                  "  pm.expect(body.device.sensorId).to.eql(Number(pm.collectionVariables.get(\"sensorId\")));",
                  "  pm.expect(body.device.location).to.eql(\"Phase 2 QA - Updated\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "id": "fe0a342f-874c-445b-8f01-4a096f0d5ff4",
          "name": "06 Capture queue baseline",
