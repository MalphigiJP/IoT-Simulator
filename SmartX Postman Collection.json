            "method": "GET",
            "header": [],
            "url": "http://localhost:5001/api/telemetry/queue/status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const s=pm.response.json();",
                  "pm.collectionVariables.set(\"queueBaseline\",JSON.stringify(s));",
                  "pm.test(\"Both queue data structures available\",()=>{",
                  "  pm.expect(s).to.have.property(\"normalWaiting\");",
                  "  pm.expect(s).to.have.property(\"emergencyWaiting\");",
                  "  pm.expect(s.capacity).to.eql(5000);",
                  "});"
                ]
              }
            }
          ]
        },
        {
