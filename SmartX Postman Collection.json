        {
          "id": "ca9df446-e362-4a97-962a-6900ae69e94b",
          "name": "10 Batch: two equal timestamps",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://localhost:5001/api/telemetry/batch",
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"sensorId\": {{sensorId}},\n    \"temperature\": 24,\n    \"timestamp\": \"{{sameTimestamp}}\"\n  },\n  {\n    \"sensorId\": {{sensorId}},\n    \"temperature\": 26,\n    \"timestamp\": \"{{sameTimestamp}}\"\n  }\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"sameTimestamp\", new Date().toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 202 Accepted\",()=>pm.response.to.have.status(202));",
                  "pm.test(\"Two records queued atomically\",()=>pm.expect(pm.response.json().acceptedRecords).to.eql(2));"
                ]
              }
            }
          ]
        },
        {
          "id": "13fdc38c-8d06-459a-8d74-19ab158ff966",
          "name": "11 Poll until initial five packets saved",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:5001/api/telemetry/queue/status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const s = pm.response.json();",
                  "const b = JSON.parse(pm.collectionVariables.get(\"queueBaseline\") || \"{}\");",
                  "const expected = 5;",
                  "const ready = s.processed - b.processed >= expected;",
                  "const tries = Number(pm.collectionVariables.get(\"pollTries\") || 0);",
                  "if (!ready && tries < 40) {",
                  "  pm.collectionVariables.set(\"pollTries\", tries + 1);",
                  "  pm.execution.setNextRequest(pm.info.requestId);",
                  "} else {",
                  "  pm.collectionVariables.unset(\"pollTries\");",
                  "  pm.test(\"At least \" + expected + \" queued packets persisted\", () => pm.expect(ready).to.eql(true));",
                  "  pm.test(\"No queue processing failures\", () => pm.expect(s.failed).to.eql(b.failed));",
                  "  pm.test(\"Queue not processing our batch\", () => pm.expect(s.waiting + s.processing).to.be.at.least(0));",
                  "}",
                  "if (ready) {",
                  "  pm.test(\"FIFO and priority classifications counted\",()=>{",
                  "    pm.expect(s.normalAccepted-b.normalAccepted).to.be.at.least(3);",
                  "    pm.expect(s.criticalAccepted-b.criticalAccepted).to.be.at.least(1);",
                  "    pm.expect(s.emergencyAccepted-b.emergencyAccepted).to.be.at.least(1);",
                  "    pm.expect(s.normalProcessed-b.normalProcessed).to.be.at.least(3);",
                  "    pm.expect(s.criticalProcessed-b.criticalProcessed).to.be.at.least(1);",
                  "    pm.expect(s.emergencyProcessed-b.emergencyProcessed).to.be.at.least(1);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "id": "afb246c2-7891-4ba8-9adb-9c5c83219c97",
          "name": "12 Timeline order and duplicate timestamps",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:5001/api/sensors/{{sensorId}}/telemetry/timeline"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "const rows = pm.response.json();",
                  "const stamps=rows.map(r=>Date.parse(r.timestamp + (/[zZ]|[+-]\\d\\d:\\d\\d$/.test(r.timestamp)?\"\":\"Z\")));",
                  "pm.test(\"At least five telemetry records present\",()=>pm.expect(rows.length).to.be.at.least(5));",
                  "pm.test(\"Chronological order\",()=>{",
                  "  for(let i=1;i<stamps.length;i++) pm.expect(stamps[i]).to.be.at.least(stamps[i-1]);",
                  "});",
                  "const same=pm.collectionVariables.get(\"sameTimestamp\").slice(0,19);",
                  "pm.test(\"Both identical-timestamp readings preserved\",()=>{",
                  "  pm.expect(rows.filter(r=>r.timestamp.slice(0,19)===same).length).to.be.at.least(2);",
                  "});"
                ]
              }
            }
          ]
        },
