{
  "info": {
    "name": "Smart-X — Phase 2 Functional API Tests (localhost:5001)",
    "_postman_id": "216b1bea-aec2-46d5-aee6-f595901ebca6",
    "description": "Run folder 01 in Postman Collection Runner with a 250–500 ms request delay and no parallel simulator traffic. It creates a disposable sensor and covers Queue<T>, PriorityQueue<TElement,TPriority>, Dictionary, SortedDictionary and HashSet alerts via HTTP. For offline detection, wait >130 seconds and run folder 02 manually. Run folder 03 last to delete the test sensor. Unit tests (dotnet test) prove actual priority dequeue order, FIFO and cache boundaries deterministically.\n\nAll 32 request URLs explicitly use http://localhost:5001 (no baseUrl variable). Start ASP.NET Core with that HTTP address enabled, e.g. applicationUrl: http://localhost:5000;http://localhost:5001. The collection still uses sensorId, testMac, sameTimestamp, and queueBaseline for test data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 — Automated Phase 2 Checks (run this folder)",
      "item": [
        {
          "id": "206493c0-3c3d-476d-85d3-f92bf41d3a41",
          "name": "01 API health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:5001/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "id": "41ebaee4-2108-401a-aff1-c52fe9e0a10a",
          "name": "02 Create disposable test sensor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://localhost:5001/api/sensors",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"macAddress\": \"{{testMac}}\",\n  \"location\": \"Phase 2 QA - Initial\",\n  \"category\": \"Environmental\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Creates a new uniquely addressed sensor; never tests against your existing registered sensors."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Array.from({length:3}, () => Math.floor(Math.random()*256).toString(16).padStart(2,\"0\").toUpperCase()).join(\":\");",
                  "pm.collectionVariables.set(\"testMac\", \"02:DA:7A:\" + suffix);",
                  "pm.collectionVariables.unset(\"sensorId\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201 Created\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  const s = pm.response.json();",
                  "  pm.collectionVariables.set(\"sensorId\", String(s.id));",
                  "  pm.test(\"Stored new sensor ID and MAC\", () => {",
                  "    pm.expect(s.id).to.be.a(\"number\");",
                  "    pm.expect(s.macAddress.toUpperCase()).to.eql(pm.collectionVariables.get(\"testMac\"));",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "id": "75c25ee9-e889-48e5-9c99-add155c84dbc",
          "name": "03 Live registry contains new sensor",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:5001/api/devices/live"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const devices = pm.response.json();",
                  "const id = Number(pm.collectionVariables.get(\"sensorId\"));",
                  "pm.test(\"New sensor exists in live MAC dictionary\", () => {",
                  "  pm.expect(devices.some(d => d.sensorId === id && d.macAddress === pm.collectionVariables.get(\"testMac\"))).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "id": "30780b08-1432-43d3-b268-7124a5941b0b",
          "name": "04 Update sensor metadata",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://localhost:5001/api/sensors/{{sensorId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"macAddress\": \"{{testMac}}\",\n  \"location\": \"Phase 2 QA - Updated\",\n  \"category\": \"Environmental\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"SQL registration updated\", () => pm.expect(pm.response.json().location).to.eql(\"Phase 2 QA - Updated\"));"
                ]
              }
            }
          ]
        },
        {
          "id": "599bb19a-423e-4a04-8180-1bf438622a48",
          "name": "05 MAC-based registry lookup",
